{
    "compilerOptions": {
        "checkJs": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@config/*": ["src/config/*"],
            "@models/*": ["src/models/*"],
            "@middlewares/*": ["src/middlewares/*"],
            "@controllers/*": ["src/controllers/*"],
            "@routes/*": ["src/routes/*"],
            "@helpers/*": ["src/helpers/*"],
            "@utils/*": ["src/utils/*"],
            "@services/*": ["src/services/*"],
            "@validators/*": ["src/validators/*"]
        }
    },
    "exclude": ["node_modules"]
}
